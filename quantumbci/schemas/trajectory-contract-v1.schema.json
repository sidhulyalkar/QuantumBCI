{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sidhulyalkar/QuantumBCI/blob/main/quantumbci/schemas/trajectory-contract-v1.schema.json",
  "title": "QuantumBCI E002 Trajectory Contract v1",
  "description": "Portable fixed-window trajectory evidence authority descriptor. Paths are navigational; scientific identity is content-addressed from loaded arrays and declared authority semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "case_id",
    "latent_dimension",
    "time_step_policy",
    "expected_window_seconds",
    "expected_step_seconds",
    "purge_seconds",
    "source_revisions",
    "data",
    "split"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "latent_dimension": {"type": "integer", "minimum": 1},
    "time_step_policy": {"const": "fixed"},
    "expected_window_seconds": {"type": "number", "exclusiveMinimum": 0},
    "expected_step_seconds": {"type": "number", "exclusiveMinimum": 0},
    "step_tolerance_seconds": {"type": "number", "minimum": 0, "default": 0.000001},
    "purge_seconds": {"type": "number", "minimum": 0},
    "upstream_authority_fingerprint": {
      "type": ["string", "null"],
      "description": "Optional fingerprint of the upstream neurOS or other sample-level evidence authority."
    },
    "source_revisions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "case_metadata": {"type": "object"},
    "data_metadata": {"type": "object"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "trajectory_ids", "start_times_s", "stop_times_s"],
      "properties": {
        "states": {"type": "string", "minLength": 1},
        "trajectory_ids": {"type": "string", "minLength": 1},
        "start_times_s": {"type": "string", "minLength": 1},
        "stop_times_s": {"type": "string", "minLength": 1},
        "valid_mask": {"type": "string", "minLength": 1}
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit_indices",
        "calibration_indices",
        "evaluation_indices",
        "representation_fit_indices"
      ],
      "properties": {
        "fit_indices": {"$ref": "#/$defs/indexSet"},
        "calibration_indices": {"$ref": "#/$defs/indexSetAllowEmpty"},
        "evaluation_indices": {"$ref": "#/$defs/indexSet"},
        "representation_fit_indices": {"$ref": "#/$defs/indexSet"}
      }
    }
  },
  "$defs": {
    "indexSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "indexSetAllowEmpty": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  }
}
